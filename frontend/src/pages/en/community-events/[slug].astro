---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import { getEntrySlug, isEntryForLocale } from "@/i18n/utils";
import { generateBlogPath } from "@/helper/generatePath";

export const getStaticPaths = (async () => {
  const blogEntries = await getCollection("blogs", isEntryForLocale("en"));

  return blogEntries.map((entry) => ({
    params: { slug: getEntrySlug(entry) },
  }));
}) satisfies GetStaticPaths;

const { slug } = Astro.params;
return Astro.redirect(generateBlogPath(`/${slug}`, "en"));
---
