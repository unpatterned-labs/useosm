---
import Hero from "@/components/home/astro-components/hero.astro";
import AboutOSM from "@/components/home/astro-components/about-osm.astro";
import Layout from "@/layouts/page-layout.astro";
import HowOsmWorks from "@/components/home/astro-components/how-osm-works.astro";
import { OSMStats } from "@/components/home/react-components/osm-stats";
import OrgsUsingOsm from "@/components/home/astro-components/orgs_using_osm.astro";
import OsmResources from "@/components/home/astro-components/osm-resources.astro";
import OsmCommunity from "@/components/home/astro-components/osm-community.astro";
import EventAnnouncement from "@/components/ui/react/event-announcement";
import { getBlogsContent, getHomeContent } from "@/i18n/utils";

const home = getHomeContent(Astro.currentLocale);
const blogs = getBlogsContent(Astro.currentLocale);
---

<Layout title={home.title} description={home.description}>
  <Hero />
  <EventAnnouncement client:load events={blogs} />
  <AboutOSM />
  <OSMStats client:load title={home.OSMStats.title} />
  <OrgsUsingOsm />
  <OsmResources />
  <OsmCommunity />
  <HowOsmWorks />
</Layout>
