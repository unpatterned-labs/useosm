---
import OSMResources from "@/components/home/react-components/osm-resources";
import { Button } from "@/components/ui/react/button";
import { getHomeContent } from "@/i18n/utils";

const home = getHomeContent(Astro.currentLocale);
---

<section class="bg-surface-30 py-12 md:px-12 lg:px-24">
  <div class="mx-auto w-full max-w-screen-xl space-y-14 px-4">
    <div class="flex flex-col justify-between lg:flex-row lg:items-center">
      <h3 class="text-grey-400 text-2xl font-semibold md:w-[32rem] md:text-4xl">
        {home.OSMResources.title}
      </h3>
      <p
        class="text-grey-300 max-w-3xl flex-auto text-sm font-light md:max-w-[32rem] md:pt-6 md:text-xl"
      >
        {home.OSMResources.description}
      </p>
    </div>
    <div class="min-h-[40rem] w-full">
      <OSMResources client:load disablePagination={true} />
    </div>
    <div class="mt-20 mb-12 flex justify-center">
      <Button
        size="lg"
        className="w-fit text-center text-xs"
        id="start-contributing-button"
        href={home.OSMResources.cta.link}
        client:load
      >
        {home.OSMResources.cta.title}
      </Button>
    </div>
  </div>
</section>
