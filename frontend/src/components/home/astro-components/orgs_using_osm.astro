---
import OrganizationsCarousel from "../react-components/orgs_carousel";
import { getHomeContent } from "@/i18n/utils";

const home = getHomeContent(Astro.currentLocale);
---

<section
  class="bg-surface-30 relative space-y-14 bg-[url('../assets/background/orgs_using_osm_vector.svg')] bg-right bg-no-repeat py-12 md:py-[6.69rem]"
>
  <div class="page-container">
    <div
      class="max-w-[21.4rem] space-y-4 text-start md:max-w-[36.4rem] lg:max-w-[55.4rem]"
    >
      <h3
        class="text-grey-300 text-2xl font-semibold md:text-4xl md:font-bold lg:text-6xl"
      >
        {home.OrgsUsingOSM.title}
      </h3>
      <p class="text-grey-200 text-sm font-light md:text-lg lg:text-2xl">
        {home.OrgsUsingOSM.description}
      </p>
    </div>
  </div>
  <OrganizationsCarousel
    client:load
    organizations={home.OrgsUsingOSM.Organizations}
  />
</section>
