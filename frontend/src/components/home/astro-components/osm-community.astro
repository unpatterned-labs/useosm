---
import CommunityMap from "@/components/home/react-components/community-map";
import { getHomeContent, getSiteContent } from "@/i18n/utils";

const home = getHomeContent(Astro.currentLocale);
const site = getSiteContent(Astro.currentLocale);
---

<section
  class="flex flex-col items-center justify-center space-y-14 bg-white px-4 pt-32 pb-16 md:px-12 lg:px-24"
>
  <h3
    class="text-grey-300 max-w-[37.87rem] text-center text-2xl font-semibold md:text-4xl"
  >
    {home.OSMCommunities.title}
  </h3>
  <div class="h-full min-w-full">
    <CommunityMap
      client:only={true}
      mapTitle={home.OSMCommunities.map.title}
      minimizeLabel={site.mapControls.minimizeLabel}
      maximizeLabel={site.mapControls.maximizeLabel}
    />
  </div>
</section>
